# ~/.ssh/config
#
# このファイルは chezmoi が管理する。直接編集しない。
# 変更する場合は dotfiles/chezmoi/private_dot_ssh/private_config.tmpl を編集し、
# リポジトリで `make secrets-apply` を実行する。

{{- if eq .chezmoi.os "darwin" }}

# NVIDIA Sync が生成する設定 (macOS のみ)
Include "{{ .chezmoi.homeDir }}/Library/Application Support/NVIDIA/Sync/config/ssh_config"
{{- end }}

Host *
  AddKeysToAgent yes
  TCPKeepAlive yes
{{ if eq .chezmoi.os "darwin" }}  UseKeychain yes
{{ end }}
# --- GitHub ---
